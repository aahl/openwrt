#!/bin/sh
# 拓扑徽标与漫游引导依赖 usteer:启用服务并写入触发阈值
# (usteer 出厂所有 SNR 阈值为 0 = 漫游逻辑完全不启动,必须显式配置)
[ -x /etc/init.d/usteer ] && /etc/init.d/usteer enable >/dev/null 2>&1

if [ -f /etc/config/usteer ]; then
	# 阈值用负数 = 绝对 dBm(usteer 语义:SNR<0 时直接当 dBm,不随各节点噪声底换算)。
	# 实测教训:usteer 的 SNR→dBm 换算用 survey 噪声底,5G ath11k 实际报 ≈-95 而非
	# 文档早期假设的 -104,旧 SNR 值(30/24)的真实阈值是 -65/-71dBm,比以为的严苛得多。
	uci -q set usteer.@usteer[0].roam_scan_snr='-74'
	uci -q set usteer.@usteer[0].signal_diff_threshold='10'

	if grep -q 'aggressiveness_mac_list' /sbin/usteerd 2>/dev/null; then
		# ---- 协商阶梯(usteer >= 2024-10,commit 49ba5f1) ----
		# aggressiveness 1=纯协商:终端拒绝 BSS 切换请求 → 取消踢线并退避(绝不硬踢)
		#               2=+Disassociation Imminent 警告位(roam_kick_delay 后踢)
		#               3=+倒计时给终端看(到点仍不走才断,推荐默认)
		#               4=+到期强制 deauth(只给顽固 Windows,建议走 per-MAC 列表)
		# 配套补丁(patches/001):min_snr 之下的拒收重连/踢线会先查全节点是否有更优
		# 候选,客户端没有更好的去处就放行——亚瑟是死角唯一可用 AP 时不再锁死终端。
		uci -q set usteer.@usteer[0].aggressiveness='3'
		# 3 次引导无响应 → 冷却 20s 重试;踢线交给协商阶梯负责,不再"3 次就踢"
		uci -q set usteer.@usteer[0].roam_scan_timeout='20000'
		# 兜底大锤:真不可用(-90dBm)才踢,且仅当集群视角存在更优候选
		uci -q set usteer.@usteer[0].min_snr='-90'
		# 连续 10s 低于兜底才踢,过滤人体/拐角瞬时遮挡
		uci -q set usteer.@usteer[0].min_snr_kick_delay='10000'
		# 终端明确拒绝协商后 60s 内尊重其选择不再骚扰
		uci -q set usteer.@usteer[0].steer_reject_timeout='60000'
		# 连接引导("谁近/谁闲连谁"):终端发起连接时,本节点先查集群视角(各节点听到的
		# 信号/负载,probe 帧广播全网可见),存在明显更优节点(好 10dB 或客户端数少 3)
		# 就拒绝自己,终端自动落到正确节点。无需终端支持 11k/v,Windows 也生效;
		# 仅作用于新建连接,已连接且链路尚可的终端不折腾(与主流一致)
		uci -q set usteer.@usteer[0].assoc_steering='1'
		uci -q set usteer.@usteer[0].load_balancing_threshold='3'
		# per-MAC 覆盖示例(格式 <小写MAC>,<0-4>),按需手工启用:
		#uci -q add_list usteer.@usteer[0].aggressiveness_mac_list='aa:bb:cc:dd:ee:ff,4'  # 顽固 Windows:到期强制断
		#uci -q add_list usteer.@usteer[0].aggressiveness_mac_list='11:22:33:44:55:66,1'  # 老 IoT:只协商永不强踢
	else
		# ---- 旧版 usteer 无协商机制,维持实机调优参数(SNR 语义,勿改负数) ----
		#   roam_scan_timeout=0 : 3 次引导无响应 → 升级踢线(>0 = 永远只重试不踢,
		#                          无视 11k 的粘性终端永远切不走,实测踩坑)
		#   min_snr=24          : SNR≈24(旧版无补丁,须防"踢-连"死循环保持原值)
		uci -q set usteer.@usteer[0].roam_scan_snr='30'
		uci -q set usteer.@usteer[0].min_snr='24'
		uci -q set usteer.@usteer[0].roam_scan_timeout='0'
	fi
	uci -q commit usteer
fi

# 11r 补漏:用户手动添加的 AP iface(非固件模板生成)若开了 11r 却缺 ft_psk_generate_local,
# FT 密钥生成断裂会让整个漫游域的快速漫游失败,客户端抱死旧 AP
# (实测: cs-02 上 LuCI 手建的 wifinet2 踩此坑,源头是它 sae-mixed 且无本地 FT 密钥)
_ft_changed=0
for _s in $(uci -q show wireless 2>/dev/null | sed -n "s/wireless\.\([^.=]*\)=wifi-iface/\1/p"); do
	if [ "$(uci -q get wireless.$_s.ieee80211r 2>/dev/null)" = "1" ] &&
	   [ -z "$(uci -q get wireless.$_s.ft_psk_generate_local 2>/dev/null)" ]; then
		uci -q set wireless.$_s.ft_psk_generate_local='1'
		_ft_changed=1
	fi
done
[ "$_ft_changed" = "1" ] && uci -q commit wireless

[ -x /etc/init.d/usteer ] && /etc/init.d/usteer start >/dev/null 2>&1

# 清除 LuCI 菜单缓存(opkg 在线安装场景)
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.* /tmp/luci-modulecache /tmp/luci-modulecache.* >/dev/null 2>&1

exit 0
